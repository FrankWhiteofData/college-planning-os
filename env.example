# Copy this file to ".env" and paste your key after the = sign.
# Get a free key in ~1 minute at: https://api.data.gov/signup/
# The .env file is git-ignored and is read ONLY by the server (never the browser).

COLLEGE_SCORECARD_API_KEY=PASTE_KEY_HERE

# Optional: change the port the app runs on (default 3000)
# PORT=3000
